{
  "manifest_version": 3,
  "name": "网页视频下载器 · MediaGrab",
  "short_name": "MediaGrab",
  "version": "1.1.1",
  "description": "嗅探网页中正在播放的 HLS / MP4 视频并下载，支持 AES-128 解密与 MP4 转封装。不绕过任何 DRM。",
  "minimum_chrome_version": "116",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "offscreen",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "网页视频下载器",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
